# ─── Marisol Chat — server environment ───
# Copy to .env and fill in. Never commit .env.

PORT=3000

# ElevenLabs — scripted TTS voice + optional live conversational call
# Get keys at https://elevenlabs.io  (Profile → API Keys)
ELEVENLABS_API_KEY=
# Voice used for scripted narration + Stage 3 voice memo (Voice Library → copy Voice ID)
ELEVENLABS_VOICE_ID=
# Optional voice used only by the call-first demo (for example, Rohmad's Voice ID).
ELEVENLABS_CALL_VOICE_ID=
# Model for TTS. eleven_turbo_v2_5 = low latency; eleven_multilingual_v2 = higher quality
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# Conversational AI agent (Marisol persona) for the "Talk to Marisol live" mode.
# Create in ElevenLabs → Conversational AI → Agents, then copy the Agent ID.
ELEVENLABS_AGENT_ID=

# Anthropic — Stage 5→6 on-rails personalization of the reflected reading
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
