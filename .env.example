# Copy to `.env.local` and fill in. `.env.local` is git-ignored; this file is
# the only one that is tracked, and it stays empty — variable names are not
# secrets, values are.
#
# The real values are not in this repository and never will be. Get them from
# whoever owns the CPV One account, out of band. Do not paste them here.

# ── Server only. Read in `api/cpv/_cpv.js`, never in the browser bundle. ──
#
# No VITE_ prefix on any of these, deliberately: Vite compiles every
# VITE_-prefixed value into `dist/`, so a key named that way ships to every
# visitor. If you add a CPV variable, it does not get that prefix.

# The CPV One install you log in to, without `/api`. A self-hosted CPV Lab can
# live in a subdirectory, e.g. https://example.com/cpvlab/ — keep the path.
CPV_ONE_API_URL=

# Settings → General Settings → Enable API Access, then set a key.
CPV_ONE_API_KEY=

# Only for installs that scope calls to one account. Leave blank otherwise.
CPV_ONE_ACCOUNT_ID=

# Used only when CPV One reports no URL for a campaign. Leave blank otherwise.
CPV_ONE_TRACKING_BASE_URL=

# Which Extra Token slot carries the channel id, 1–15.
#
# 11 in this account. extra1 is utm_source and the traffic-source reporting
# depends on it; extra2–extra4 are also in use; 11–15 are free account-wide.
# Run `npm run cpv:check` to confirm before changing this.
#
# Whichever number you pick, each campaign in CPV One must have that Extra Token
# configured to read the parameter `channel_id`, or linking is refused.
CPV_ONE_CHANNEL_TOKEN=11

# ── Browser. These DO ship in `dist/`, so nothing secret goes here. ──

# Where the player is served from. Defaults to wherever the editor is open,
# which is right in development and on any single-origin deploy.
VITE_CHAT_BASE_URL=

# The shape of a tracking URL. Defaults to `{base}/?f={id}&channel_id={channel_id}`,
# which is what this build actually serves. The `/chat/{slug}` form needs a host
# rewrite to reach the same page.
VITE_CHAT_URL_PATTERN=
